# Logo Fetcher Configuration
# Copy this file to .env and optionally add your API keys

# API Keys (Optional - APIs work without them, but keys may provide better results)
# Get your logo.dev API key at: https://logo.dev
LOGODEV_API_KEY=

# Get your Brandfetch API key at: https://brandfetch.com/developers
BRANDFETCH_API_KEY=

# Timeouts (in seconds)
REQUEST_TIMEOUT=10.0
SCRAPER_TIMEOUT=15.0

# Source configuration
ENABLE_LOGODEV=true
ENABLE_BRANDFETCH=true
ENABLE_SCRAPER=true

# Caching
CACHE_TTL=3600
REDIS_URL=

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100

# Minimum logo dimensions
MIN_LOGO_WIDTH=32
MIN_LOGO_HEIGHT=32
